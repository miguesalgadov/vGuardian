# ===== App =====
APP_NAME="eGuardian AI Concierge"
APP_ENV=local
APP_KEY=base64:GENERAR_CON_php_artisan_key_generate
APP_URL=http://localhost
APP_TIMEZONE=America/Santiago

# ===== Base de datos (PostgreSQL) =====
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=eguardian
DB_USERNAME=eguardian
DB_PASSWORD=secret

# ===== Cache / colas =====
REDIS_HOST=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ===== Auth JWT =====
JWT_SECRET=GENERAR_CON_php_artisan_jwt_secret
JWT_TTL=60
JWT_REFRESH_TTL=20160

# ===== OpenAI / IA =====
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_VOICE=nova

# ===== WebSockets (Reverb) =====
REVERB_APP_ID=eguardian
REVERB_APP_KEY=local_key
REVERB_APP_SECRET=local_secret
REVERB_HOST=localhost
REVERB_PORT=8080

# ===== Frontend (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost/ws

# ===== Cumplimiento / privacidad =====
DATA_RETENTION_DAYS=90
AUDIT_LOG_ENABLED=true
